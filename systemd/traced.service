[Unit]
Description=trace source index

[Service]
Type=simple
EnvironmentFile=%h/.config/trace/environment
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env traced
RuntimeDirectory=trace
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=default.target
